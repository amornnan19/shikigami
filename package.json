{
  "name": "shikigami",
  "private": true,
  "version": "0.8.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "e2e": "tauri build --debug --no-bundle --features e2e --config e2e/tauri.e2e.conf.json && wdio run e2e/wdio.conf.ts && wdio run e2e/wdio.restart.conf.ts && wdio run e2e/wdio.stall.conf.ts && wdio run e2e/wdio.startup-error.conf.ts && wdio run e2e/wdio.auth-mode.conf.ts && wdio run e2e/wdio.edit-delete.conf.ts && wdio run e2e/wdio.missing-cli.conf.ts && wdio run e2e/wdio.groups.conf.ts && wdio run e2e/wdio.group-turns.conf.ts && wdio run e2e/wdio.group-restart.conf.ts && wdio run e2e/wdio.group-mentions.conf.ts",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p scripts",
    "test": "vitest run",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "bun run lint && bun run typecheck && bun run test && bun run rust:fmt && bun run rust:lint && bun run rust:test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.108.4",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-opener": "2.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.82.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@wdio/cli": "9.33.1",
    "@wdio/globals": "9.33.1",
    "@wdio/local-runner": "9.33.1",
    "@wdio/mocha-framework": "9.33.1",
    "@wdio/tauri-service": "1.5.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
